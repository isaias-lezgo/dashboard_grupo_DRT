# GoHighLevel — used ONLY by the dev MCP server (.mcp.json), NOT by the app.
# The app reads its GHL credentials per-client from DASHBOARD_CLIENTS below.
GHL_API_TOKEN=
GHL_LOCATION_ID=

# Anthropic (server-side only, AI assistant)
ANTHROPIC_API_KEY=

# Dashboard login gate (server-side only, never exposed to the browser).
#
# DASHBOARD_CLIENTS: JSON array — one entry per client. Each client logs in with
#   their own password, which resolves to their own GHL token + location, so a
#   client only ever sees their own data.
#   `password` is OPTIONAL: omit it and the client's locationId doubles as the
#   password. Add it to give one client a real, rotatable password.
#   Use `npm run add-client` to extend this safely.
#
#   [{"id":"yconia","name":"Yconia","locationId":"abc123","ghlToken":"pit-..."}]
#
# DASHBOARD_AUTH_SECRET: random string to sign the session cookie (openssl rand -hex 32).
DASHBOARD_CLIENTS=
DASHBOARD_AUTH_SECRET=

# Caché de sincronización (Neon Postgres, vía el Marketplace de Vercel).
#
# OPCIONAL: sin estas variables la app funciona exactamente como antes — cada
# carga hace el sync completo contra GHL. Con ellas, la carga normal sirve el
# payload ya guardado y refresca en segundo plano.
#
# La integración de Neon en Vercel inyecta ambas sola; en local se bajan con
# `vercel env pull .env.local`. DATABASE_URL_UNPOOLED solo la usa
# `pnpm db:migrate` (pgbouncer en modo transaction estorba al DDL).
#
# Usa una base PROPIA de este despliegue: la tabla se indexa por id de cliente y
# dos despliegues con un id repetido se pisarían el payload sin avisar.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
